R2PM_BEGIN

R2PM_GIT "https://github.com/hamidrezakp/r2fas"
R2PM_DESC "FASM .fas symbolic debug information loader for radare2"
R2PM_NEEDS "cargo rustc make pkg-config"

R2PM_INSTALL() {
	${MAKE} install PLUGINDIR="${R2PM_PLUGDIR}" || exit 1
}

R2PM_UNINSTALL() {
	${MAKE} uninstall PLUGINDIR="${R2PM_PLUGDIR}"
}

R2PM_END
