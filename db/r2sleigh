R2PM_BEGIN

R2PM_GIT "https://github.com/0verflowme/r2sleigh"
R2PM_DESC "Sleigh-based analysis shell and Sleigh-to-r2il compiler"

R2PM_NEEDS "rustc cargo"

R2PM_INSTALL() {
	cargo build --release --target-dir target -p r2s -p r2sleigh-cli \
		--features r2s/sleigh,r2sleigh-cli/all-archs || exit 1
	mkdir -p "${R2PM_BINDIR}" || exit 1
	cp -f target/release/r2s target/release/r2sleigh "${R2PM_BINDIR}/" || exit 1
}

R2PM_UNINSTALL() {
	rm -f "${R2PM_BINDIR}/r2s" "${R2PM_BINDIR}/r2sleigh"
}

R2PM_END
