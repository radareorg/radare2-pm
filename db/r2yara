R2PM_BEGIN

R2PM_GIT "https://github.com/radareorg/r2yara"
R2PM_DESC "YARA plugin for radare2"
R2PM_PLATFORMS "linux darwin windows"
R2PM_VERSION_MAP "6.2.4:1.5.2 6.2.6:1.5.4"
R2PM_DEPS yara

R2PM_BINSTALL() {
	[ -n "${R2PM_VERSION}" ] || R2PM_FAIL "r2yara binary installation requires a mapped R2PM_VERSION"
	[ "${R2PM_OFFLINE}" != 1 ] || R2PM_FAIL "Cannot download r2yara in offline mode"
	asset="r2yara-${R2V}-${R2PM_TRIPLET}.zip"
	workdir=$(mktemp -d)
	trap 'rm -rf "$workdir"' 0
	curl -fsSL -o "$workdir/$asset" "https://github.com/radareorg/r2yara/releases/download/${R2PM_VERSION}/${asset}" || R2PM_FAIL "No r2yara ${R2PM_VERSION} binary for radare2 ${R2V} on ${R2PM_TRIPLET}"
	unzip -qo "$workdir/$asset" 'plugins/*' -d "$workdir"
	${R2PM_SUDO} mkdir -p "${R2PM_PLUGDIR}"
	${R2PM_SUDO} cp -Rf "$workdir/plugins/." "${R2PM_PLUGDIR}/"
}

R2PM_BINSTALL_WINDOWS() {
	if "%R2PM_VERSION%"=="" (echo r2yara binary installation requires a mapped R2PM_VERSION & exit /b 1)
	if "%R2PM_OFFLINE%"=="1" (echo Cannot download r2yara in offline mode & exit /b 1)
	curl -fsSL -o "%TEMP%\r2yara.zip" "https://github.com/radareorg/r2yara/releases/download/%R2PM_VERSION%/r2yara-%R2V%-%R2PM_TRIPLET%.zip" || (echo No r2yara %R2PM_VERSION% binary for radare2 %R2V% on %R2PM_TRIPLET% & exit /b 1)
	if not exist "%R2PM_PLUGDIR%" (mkdir "%R2PM_PLUGDIR%" || exit /b 1)
	tar -xf "%TEMP%\r2yara.zip" --strip-components=1 -C "%R2PM_PLUGDIR%" plugins || exit /b 1
	del "%TEMP%\r2yara.zip" || exit /b 1
}

R2PM_BUNINSTALL() {
	${R2PM_SUDO} rm -f "${R2PM_PLUGDIR}/core_r2yara.${R2_LIBEXT}"
	${R2PM_SUDO} rm -rf "${R2PM_PLUGDIR}/rules-yara3"
}

R2PM_BUNINSTALL_WINDOWS() {
	if exist "%R2PM_PLUGDIR%\core_r2yara.dll" (del /f /q "%R2PM_PLUGDIR%\core_r2yara.dll" || exit /b 1)
	if exist "%R2PM_PLUGDIR%\rules-yara3" (rmdir /s /q "%R2PM_PLUGDIR%\rules-yara3" || exit /b 1)
}

R2PM_INSTALL() {
	./configure --prefix="${R2PM_PREFIX}" || R2PM_FAIL "Configure"
	${MAKE} || R2PM_FAIL "Build"
	if [ "${R2PM_GLOBAL}" = 1 ]; then
		${SUDO} ${MAKE} install || R2PM_FAIL "Install"
	else
		${MAKE} user-install || R2PM_FAIL "Install"
	fi
}

R2PM_UNINSTALL() {
	if [ "${R2PM_GLOBAL}" = 1 ]; then
		${SUDO} ${MAKE} uninstall
	else
		${MAKE} user-uninstall
	fi
}

R2PM_END
