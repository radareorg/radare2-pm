R2PM_BEGIN

R2PM_GIT "https://github.com/radareorg/r2hexpat"
R2PM_DESC "ImHex pattern language (.hexpat) support for radare2 using r2js"
R2PM_DEPS r2frida

R2PM_INSTALL() {
	${MAKE} user-install
}

R2PM_UNINSTALL() {
	${MAKE} user-uninstall
}

R2PM_INSTALL_WINDOWS() {
	r2frida-compile -S -B iife -o hexpat.r2.js r2/plugin.ts
	copy /y hexpat.r2.js %R2PM_PLUGDIR%\hexpat.r2.js
}

R2PM_UNINSTALL_WINDOWS() {
	del %R2PM_PLUGDIR%\hexpat.r2.js
}

R2PM_END
