R2PM_BEGIN

R2PM_GIT "https://github.com/radareorg/radare2-extras"
R2PM_DESC "Support for the MD32 architecture"

R2PM_INSTALL() {
	cd md32 || exit 1
	${MAKE} clean || exit 1
	${MAKE} || exit 1
	${MAKE} install R2PM_PLUGDIR="${R2PM_PLUGDIR}" || exit 1
}

R2PM_UNINSTALL() {
	${MAKE} -C md32 uninstall R2PM_PLUGDIR="${R2PM_PLUGDIR}" || exit 1
}

R2PM_END
