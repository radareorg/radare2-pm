R2PM_BEGIN

R2PM_GIT "https://github.com/radareorg/r2hermes"
R2PM_DESC "React Native aka Hermes Bytecode disassembler & decompiler plugin for r2"

R2PM_BINSTALL() {
	asset="r2hermes-${R2V}-${R2PM_OS}-${R2PM_ARCH}-${R2PM_BITS}.zip"
	workdir=$(mktemp -d)
	curl -fsSL -o "$workdir/$asset" "https://github.com/radareorg/r2hermes/releases/latest/download/${asset}" || R2PM_FAIL "No r2hermes ${R2V} binary for ${R2PM_OS}-${R2PM_ARCH}-${R2PM_BITS}"
	unzip -qoj "$workdir/$asset" 'plugins/*' -d "${R2PM_PLUGDIR}"
	unzip -qoj "$workdir/$asset" 'bin/*' -d "${R2PM_BINDIR}"
	rm -rf "$workdir"
}

R2PM_BINSTALL_WINDOWS() {
	curl -fsSL -o "%TEMP%\r2hermes.zip" https://github.com/radareorg/r2hermes/releases/latest/download/r2hermes-%R2V%-windows-%R2PM_ARCH%-%R2PM_BITS%.zip || (echo No r2hermes %R2V% binary for windows-%R2PM_ARCH%-%R2PM_BITS% & exit 1)
	(mkdir "%R2PM_PLUGDIR%" "%R2PM_BINDIR%" 2>nul || cd .)
	tar -xf "%TEMP%\r2hermes.zip" --strip-components=1 -C "%R2PM_PLUGDIR%" plugins
	tar -xf "%TEMP%\r2hermes.zip" --strip-components=1 -C "%R2PM_BINDIR%" bin
	del "%TEMP%\r2hermes.zip"
}

R2PM_INSTALL() {
	${MAKE} clean || true
	${MAKE} || R2PM_FAIL "make"
	${MAKE} user-install
}

R2PM_UNINSTALL() {
	rm -f "${R2PM_PLUGDIR}"/*_hbc.${R2_LIBEXT} "${R2PM_BINDIR}/r2hermes"
}

R2PM_UNINSTALL_WINDOWS() {
	del "%R2PM_PLUGDIR%\*hbc.dll"
	del "%R2PM_BINDIR%\r2hermes.exe"
}

R2PM_END
