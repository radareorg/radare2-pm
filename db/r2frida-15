R2PM_BEGIN

R2PM_GIT "https://github.com/nowsecure/r2frida"
R2PM_DESC "r2frida IO plugin"

R2PM_DOC="
r2frida is an IO plugin for r2 that talks with Frida.
This allows to interact with local and remote processes.

$ r2 frida:///bin/ls
[0x00000000]> :i*
e asm.arch=x86
e asm.bits=64
e asm.os=darwin

You can also connect to Android/iOS gadgets or servers:

$ r2 frida://{device-id}/{application-name|process-id}
"

R2PM_INSTALL_WINDOWS() {
	curl -fsSL -o "%TEMP%\r2frida.zip" https://github.com/nowsecure/r2frida/releases/download/5.7.8/r2frida-5.7.8-w64.zip
	(mkdir "%R2PM_PLUGDIR%" 2>nul || cd .)
	tar -xf "%TEMP%\r2frida.zip" -C "%R2PM_PLUGDIR%" io_frida.dll
	if exist "%TEMP%\r2frida.zip" del "%TEMP%\r2frida.zip"
}

R2PM_INSTALL() {
	unset CFLAGS
	unset LDFLAGS
	echo "Building the native plugin and using the precompiled agent"
	./configure --with-precompiled-agent
	${MAKE} frida_version=15.2.2 || R2PM_FAIL "Build failed"
	${MAKE} user-install R2_PLUGDIR="${R2PM_PLUGDIR}" || R2PM_FAIL "Install fail"
}

R2PM_UNINSTALL() {
	${MAKE} user-uninstall R2_PLUGDIR="${R2PM_PLUGDIR}" || exit 1
}

R2PM_UNINSTALL_WINDOWS() {
	if exist "%R2PM_PLUGDIR%\io_frida.dll" del "%R2PM_PLUGDIR%\io_frida.dll"
	if exist "%R2_USER_PLUGINS%\io_frida.dll" del "%R2_USER_PLUGINS%\io_frida.dll"
}

R2PM_END
