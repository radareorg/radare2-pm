R2PM_BEGIN

R2PM_GIT "https://github.com/radareorg/radare2-extras"
R2PM_DESC "QuickJS bytecode arch, assembler, pseudo and bin plugins"
R2PM_PLATFORMS "linux darwin"
R2PM_NEEDS "git make pkg-config"

R2PM_DOC="QJS_REPO and QJS_REF select the QuickJS repository and revision at build time.
QJS_DIR selects an existing local source tree. QJS_CFLAGS matches custom VM options."

R2PM_INSTALL() {
	cd qjs || exit 1
	${MAKE} PLUGDIR="${R2PM_PLUGDIR}" user-install || exit 1
}

R2PM_UNINSTALL() {
	rm -f "${R2PM_PLUGDIR}/arch_qjs.${R2_LIBEXT}" \
		"${R2PM_PLUGDIR}/parse_qjs_pseudo.${R2_LIBEXT}" \
		"${R2PM_PLUGDIR}/bin_qjs.${R2_LIBEXT}"
}

R2PM_END
