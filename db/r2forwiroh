R2PM_BEGIN

R2PM_GIT "https://github.com/radareorg/radare2-extras"
R2PM_DESC "Share r2 sessions over Forwiroh with r2fw"
R2PM_NEEDS "cc make pkg-config cargo rustc"
R2PM_PLATFORMS "linux darwin"

R2PM_INSTALL() {
	${MAKE} -C r2forwiroh clean || exit 1
	${MAKE} -C r2forwiroh || exit 1
	${R2PM_SUDO} ${MAKE} -C r2forwiroh install R2PM_PLUGDIR="${R2PM_PLUGDIR}" || exit 1
}

R2PM_UNINSTALL() {
	${R2PM_SUDO} rm -f "${R2PM_PLUGDIR}/core_r2forwiroh.${R2_LIBEXT}" || exit 1
}

R2PM_END
